{
	"env": {
		"node": true,
		"es2022": true
	},
	"extends": ["eslint:recommended", "prettier"],
	"parserOptions": {
		"ecmaVersion": 2022
	},
	"rules": {
		"no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
		"no-console": "off",
		"no-constant-condition": ["error", { "checkLoops": false }],
		"prefer-const": "warn",
		"no-var": "error"
	},
	"ignorePatterns": ["node_modules/", "export/", "logs/"]
}
